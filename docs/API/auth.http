### DevResume AI — Auth API Examples
### Use with VS Code REST Client, JetBrains HTTP Client, or httpYac

@host = http://localhost:8080
@content_type = application/json

### ─────────────────────────────────────────────
### REGISTER
### ─────────────────────────────────────────────

POST {{host}}/api/v1/auth/register
Content-Type: {{content_type}}

{
  "email": "developer@devresume.ai",
  "password": "SecurePassword123!",
  "name": "Chamath Dilshan"
}

### ─────────────────────────────────────────────
### LOGIN
### ─────────────────────────────────────────────

# @name login
POST {{host}}/api/v1/auth/login
Content-Type: {{content_type}}

{
  "email": "developer@devresume.ai",
  "password": "SecurePassword123!"
}

### ─────────────────────────────────────────────
### REFRESH TOKEN
### ─────────────────────────────────────────────

POST {{host}}/api/v1/auth/refresh
Content-Type: {{content_type}}

{
  "refresh_token": "{{login.response.body.$.refresh_token}}"
}

### ─────────────────────────────────────────────
### LOGOUT
### ─────────────────────────────────────────────

POST {{host}}/api/v1/auth/logout
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: {{content_type}}

{}

### ─────────────────────────────────────────────
### GITHUB OAUTH — Initiate
### ─────────────────────────────────────────────

GET {{host}}/api/v1/auth/github

### ─────────────────────────────────────────────
### GITHUB OAUTH — Callback (handled by redirect, not direct call)
### ─────────────────────────────────────────────

# GET {{host}}/api/v1/auth/github/callback?code=<github_code>&state=<state>

### ─────────────────────────────────────────────
### GOOGLE OAUTH — Initiate
### ─────────────────────────────────────────────

GET {{host}}/api/v1/auth/google

### ─────────────────────────────────────────────
### FORGOT PASSWORD
### ─────────────────────────────────────────────

POST {{host}}/api/v1/auth/forgot-password
Content-Type: {{content_type}}

{
  "email": "developer@devresume.ai"
}

### ─────────────────────────────────────────────
### RESET PASSWORD
### ─────────────────────────────────────────────

POST {{host}}/api/v1/auth/reset-password
Content-Type: {{content_type}}

{
  "token": "<reset_token_from_email>",
  "new_password": "NewSecurePassword456!"
}

### ─────────────────────────────────────────────
### GET CURRENT USER
### ─────────────────────────────────────────────

GET {{host}}/api/v1/users/me
Authorization: Bearer {{login.response.body.$.access_token}}

### ─────────────────────────────────────────────
### UPDATE PROFILE
### ─────────────────────────────────────────────

PUT {{host}}/api/v1/users/me
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: {{content_type}}

{
  "name": "Chamath Dilshan Colonne",
  "bio": "Full-stack Rust developer building DevResume AI",
  "location": "Colombo, Sri Lanka",
  "website": "https://devresume.ai"
}

### ─────────────────────────────────────────────
### CREATE API KEY
### ─────────────────────────────────────────────

POST {{host}}/api/v1/users/me/api-keys
Authorization: Bearer {{login.response.body.$.access_token}}
Content-Type: {{content_type}}

{
  "name": "CI/CD Pipeline Key",
  "expires_in_days": 90
}
